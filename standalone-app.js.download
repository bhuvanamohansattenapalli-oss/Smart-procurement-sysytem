// Standalone Browser Runtime for Smart Procurement Management System (SIH 2026)
// Complete Farmer + Officer Dual Workflows, Multilingual (EN, TE, HI), Interactive Map, Approval Workflow, NIR Lab Specs, Demo DBT, and AI Farmer Assistant

(function() {
  if (window.__SPMS_INITIALIZED__) return;

  const scriptsToLoad = [
    'https://unpkg.com/react@18/umd/react.production.min.js',
    'https://unpkg.com/react-dom@18/umd/react-dom.production.min.js'
  ];

  let loadedCount = 0;
  function checkAllLoaded() {
    loadedCount++;
    if (loadedCount === scriptsToLoad.length) {
      initApp();
    }
  }

  scriptsToLoad.forEach(src => {
    const s = document.createElement('script');
    s.src = src;
    s.onload = checkAllLoaded;
    s.onerror = checkAllLoaded;
    document.head.appendChild(s);
  });

  function initApp() {
    const React = window.React;
    const ReactDOM = window.ReactDOM;
    if (!React || !ReactDOM) return;

    window.__SPMS_INITIALIZED__ = true;
    const { useState, useEffect, useRef, createElement: h } = React;

    // --- LOCAL DICTIONARIES ---
    const translations = {
      en: {
        app_title: "SMART PROCUREMENT MANAGEMENT SYSTEM",
        app_sub: "Book your procurement slot, track your queue, and know your procurement status — all in one place.",
        role_farmer: "🌾 Farmer",
        role_officer: "👨‍💼 Officer",
        home: "Home",
        dashboard: "Dashboard",
        book_slot: "Book Slot",
        live_queue: "Live Queue",
        procurement: "Procurement",
        payment: "Payment",
        centres: "Centres",
        register_btn: "1. Register as Farmer",
        login_btn: "Farmer Login",
        check_status: "Check Registration Status",
        pending_approval: "🟡 Pending Officer Approval",
        approved_badge: "🟢 Approved",
        rejected_badge: "🔴 Rejected"
      },
      te: {
        app_title: "స్మార్ట్ ధాన్యం సేకరణ నిర్వహణ వ్యవస్థ",
        app_sub: "మీ ధాన్యం సేకరణ స్లాట్‌ను బుక్ చేయండి, లైవ్ క్యూ ట్రాక్ చేయండి మరియు సేకరణ స్థితిని తెలుసుకోండి.",
        role_farmer: "🌾 రైతు",
        role_officer: "👨‍💼 అధికారి",
        home: "హోమ్",
        dashboard: "డ్యాష్‌బోర్డ్",
        book_slot: "స్లాట్ బుకింగ్",
        live_queue: "లైవ్ క్యూ",
        procurement: "ధాన్యం సేకరణ",
        payment: "చెల్లింపు",
        centres: "కేంద్రాలు",
        register_btn: "1. రైతు నమోదు (Register)",
        login_btn: "రైతు లాగిన్",
        check_status: "నమోదు స్థితి తనిఖీ",
        pending_approval: "🟡 అధికారి ఆమోదం కోసం వేచి ఉంది",
        approved_badge: "🟢 ఆమోదించబడింది",
        rejected_badge: "🔴 తిరస్కరించబడింది"
      },
      hi: {
        app_title: "स्मार्ट खरीद प्रबंधन प्रणाली",
        app_sub: "अपना खरीद स्लॉट बुक करें, अपनी कतार को ट्रैक करें, और अपनी खरीद स्थिति जानें।",
        role_farmer: "🌾 किसान",
        role_officer: "👨‍💼 अधिकारी",
        home: "मुख्य पृष्ठ",
        dashboard: "डैशबोर्ड",
        book_slot: "स्लॉट बुकिंग",
        live_queue: "लाइव कतार",
        procurement: "खरीद स्थिति",
        payment: "भुगतान",
        centres: "खरीद केंद्र",
        register_btn: "1. किसान पंजीकरण (Register)",
        login_btn: "किसान लॉगिन",
        check_status: "पंजीकरण स्थिति जांचें",
        pending_approval: "🟡 अधिकारी अनुमोदन लंबित",
        approved_badge: "🟢 स्वीकृत",
        rejected_badge: "🔴 अस्वीकृत"
      }
    };

    // --- MOCK DATA ---
    const INITIAL_CENTRES = [
      {
        centreId: "CTR-GNT-01",
        name: "Guntur Main Agricultural Market Yard",
        city: "Guntur",
        code: "AP-GNT-MKT01",
        address: "Market Yard Road, Near Old Bus Stand, Guntur",
        distanceKm: 4.2,
        currentWaitMinutes: 35,
        status: "Operational",
        currentQueue: 24,
        availableSlots: 18,
        activeCounters: 4,
        nextAvailableSlot: "11:00 AM",
        inChargeOfficer: "Dr. V. Krishna Murthy",
        x: 48, y: 52
      },
      {
        centreId: "CTR-GNT-02",
        name: "Tenali Rythu Bharosa Kendra (RBK)",
        city: "Tenali",
        code: "AP-GNT-TNL02",
        address: "Station Road, Tenali Mandal",
        distanceKm: 18.5,
        currentWaitMinutes: 20,
        status: "Operational",
        currentQueue: 12,
        availableSlots: 45,
        activeCounters: 3,
        nextAvailableSlot: "10:30 AM",
        inChargeOfficer: "Sri K. Subba Rao",
        x: 68, y: 62
      },
      {
        centreId: "CTR-GNT-03",
        name: "Vijayawada Regional Grain Terminal",
        city: "Vijayawada",
        code: "AP-VJA-TRM03",
        address: "Kankipadu Highway, Vijayawada Rural",
        distanceKm: 28.0,
        currentWaitMinutes: 50,
        status: "Operational",
        currentQueue: 38,
        availableSlots: 10,
        activeCounters: 5,
        nextAvailableSlot: "01:00 PM",
        inChargeOfficer: "Smt. P. Lakshmi",
        x: 74, y: 32
      },
      {
        centreId: "CTR-GNT-04",
        name: "Pedakakani Mandi Procurement Hub",
        city: "Pedakakani",
        code: "AP-GNT-PDK04",
        address: "NH-16 Junction, Pedakakani Mandal",
        distanceKm: 1.8,
        currentWaitMinutes: 15,
        status: "Operational",
        currentQueue: 8,
        availableSlots: 60,
        activeCounters: 3,
        nextAvailableSlot: "10:00 AM",
        inChargeOfficer: "Sri B. Venkat",
        x: 55, y: 46
      },
      {
        centreId: "CTR-GNT-05",
        name: "Narasaraopet Grain Depot",
        city: "Narasaraopet",
        code: "AP-NRT-DPT05",
        address: "Palnadu Road, Narasaraopet",
        distanceKm: 42.0,
        currentWaitMinutes: 25,
        status: "Operational",
        currentQueue: 16,
        availableSlots: 32,
        activeCounters: 2,
        nextAvailableSlot: "11:30 AM",
        inChargeOfficer: "Sri M. Ramaiah",
        x: 26, y: 68
      }
    ];

    const INITIAL_REGISTRATIONS = [
      {
        registrationId: "REG-10245",
        farmerId: "FRM-10245",
        name: "Ramesh Kumar",
        mobile: "9876543210",
        village: "Pedakakani",
        district: "Guntur",
        state: "Andhra Pradesh",
        status: "Approved",
        password: "password123",
        preferredLanguage: "en",
        landAreaAcres: 4.5,
        submittedAt: new Date(Date.now() - 86400000).toISOString()
      },
      {
        registrationId: "REG-10246",
        farmerId: "FRM-10246",
        name: "Srinivasa Rao",
        mobile: "9848012345",
        village: "Chebrolu",
        district: "Guntur",
        state: "Andhra Pradesh",
        status: "Pending",
        password: "password123",
        preferredLanguage: "te",
        landAreaAcres: 6.2,
        submittedAt: new Date().toISOString()
      },
      {
        registrationId: "REG-10247",
        farmerId: "FRM-10247",
        name: "K. Venkateshwarlu",
        mobile: "9848099887",
        village: "Mangalagiri",
        district: "Guntur",
        state: "Andhra Pradesh",
        status: "Rejected",
        rejectionReason: "Pattadar passbook survey number does not match revenue record.",
        password: "password123",
        preferredLanguage: "te",
        landAreaAcres: 3.0,
        submittedAt: new Date(Date.now() - 172800000).toISOString()
      }
    ];

    // --- MAIN REACT APPLICATION ROOT ---
    function SmartProcureApp() {
      // Top Level Role: 'farmer' | 'officer'
      const [role, setRole] = useState('farmer');
      const [lang, setLang] = useState('en');
      const [view, setView] = useState('landing'); // 'landing', 'auth', 'status', 'dashboard', 'book_slot', 'queue', 'procurement', 'payments', 'centres', 'officer_login', 'officer_dashboard'

      // Farmer Session
      const [farmer, setFarmer] = useState(null);
      const [officer, setOfficer] = useState(null);

      // Registrations
      const [registrations, setRegistrations] = useState(() => {
        try {
          const saved = localStorage.getItem('spms_farmer_registrations');
          return saved ? JSON.parse(saved) : INITIAL_REGISTRATIONS;
        } catch(e) { return INITIAL_REGISTRATIONS; }
      });

      // Active Booking & Queue
      const [activeBooking, setActiveBooking] = useState({
        bookingId: "PRC-10245",
        tokenNumber: "#1059",
        centreId: "CTR-GNT-01",
        centreName: "Guntur Main Agricultural Market Yard",
        centreAddress: "Market Yard Road, Near Old Bus Stand, Guntur",
        date: "2026-08-29",
        dateDisplay: "29 August 2026",
        timeSlot: "11:00 AM – 12:00 PM",
        crop: "Paddy (Grade A)",
        variety: "BPT-5204 (Samba Mahsuri)",
        estimatedQuantityKg: 850,
        vehicleType: "Tractor-Trailer",
        driverContact: "9876543210",
        status: "Confirmed"
      });

      const [currentTokenNum, setCurrentTokenNum] = useState(1052);
      const [paymentStatus, setPaymentStatus] = useState('Pending');
      const [showPaymentModal, setShowPaymentModal] = useState(false);
      const [paymentMethod, setPaymentMethod] = useState('DBT_NPCI');

      // AI Chat Widget
      const [aiOpen, setAiOpen] = useState(false);
      const [aiMessages, setAiMessages] = useState([
        { id: 1, sender: 'ai', text: "Namaste! 🙏 I am your AI Farmer Assistant. Ask me anything about your slot booking, token number, live queue, or DBT payment." }
      ]);
      const [aiInput, setAiInput] = useState('');
      const [isListening, setIsListening] = useState(false);

      // Toast Notification state
      const [toast, setToast] = useState(null);

      const t = (k) => translations[lang]?.[k] || translations.en[k] || k;

      const showNotification = (msg, type = 'info') => {
        setToast({ msg, type });
        setTimeout(() => setToast(null), 4000);
      };

      const saveRegistrations = (newRegs) => {
        setRegistrations(newRegs);
        localStorage.setItem('spms_farmer_registrations', JSON.stringify(newRegs));
      };

      // Handle Role Switch
      const handleRoleSwitch = (newRole) => {
        setRole(newRole);
        if (newRole === 'officer') {
          if (!officer) setView('officer_login');
          else setView('officer_dashboard');
        } else {
          if (farmer) setView('dashboard');
          else setView('landing');
        }
      };

      // Voice recognition toggle
      const toggleVoice = () => {
        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRec) {
          alert("Speech recognition not supported in this browser. Please type your query.");
          return;
        }
        if (isListening) {
          setIsListening(false);
          return;
        }
        const rec = new SpeechRec();
        if (lang === 'te') rec.lang = 'te-IN';
        else if (lang === 'hi') rec.lang = 'hi-IN';
        else rec.lang = 'en-IN';

        rec.onstart = () => setIsListening(true);
        rec.onresult = (e) => {
          const text = e.results[0][0].transcript;
          if (text) {
            setAiInput(text);
            handleSendAiMessage(text);
          }
          setIsListening(false);
        };
        rec.onerror = () => setIsListening(false);
        rec.onend = () => setIsListening(false);
        rec.start();
      };

      const handleSendAiMessage = (msgText) => {
        const query = (msgText || aiInput).trim();
        if (!query) return;

        const newMsgs = [...aiMessages, { id: Date.now(), sender: 'user', text: query }];
        setAiMessages(newMsgs);
        setAiInput('');

        // Grounded intelligent NLP response
        const lower = query.toLowerCase();
        let reply = "";

        if (lower.includes('token') || lower.includes('టోకెన్') || lower.includes('टोकन')) {
          reply = lang === 'te' 
            ? `మీ టోకెన్ నంబర్ ${activeBooking?.tokenNumber || '#1059'}. ప్రస్తుతం నడుస్తున్న టోకెన్ #${currentTokenNum}.`
            : lang === 'hi'
            ? `आपका टोकन नंबर ${activeBooking?.tokenNumber || '#1059'} है। वर्तमान में टोकन #${currentTokenNum} बुलाया जा रहा है।`
            : `Your token number is ${activeBooking?.tokenNumber || '#1059'}. Currently serving token #${currentTokenNum}.`;
        } else if (lower.includes('ahead') || lower.includes('ముందు') || lower.includes('कतार') || lower.includes('wait') || lower.includes('waiting')) {
          const ahead = Math.max(0, 1059 - currentTokenNum);
          reply = lang === 'te'
            ? `మీ ముందు ${ahead} మంది రైతులు ఉన్నారు. అంచనా వేసిన నిరీక్షణ సమయం సుమారు ${ahead * 5} నిమిషాలు.`
            : lang === 'hi'
            ? `आपके आगे ${ahead} किसान हैं। अनुमानित प्रतीक्षा समय लगभग ${ahead * 5} मिनट है।`
            : `There are ${ahead} farmers ahead of you. Estimated waiting time is approximately ${ahead * 5} minutes.`;
        } else if (lower.includes('payment') || lower.includes('పేమెంట్') || lower.includes('భారం') || lower.includes('dbt') || lower.includes('पैसा')) {
          reply = lang === 'te'
            ? `మీ 850 కిలోల గ్రేడ్-ఎ వరి సేకరణకు ₹19,550 DBT మొత్తం మీ స్టేట్ బ్యాంక్ ఆఫ్ ఇండియా ఖాతాకు చెల్లించబడుతుంది. ప్రస్తుత స్థితి: ${paymentStatus}.`
            : lang === 'hi'
            ? `आपके 850 किग्रा धान के लिए ₹19,550 डीबीटी राशि स्टेट बैंक खाते में क्रेडिट होगी। स्थिति: ${paymentStatus}.`
            : `Your ₹19,550 DBT payment for 850 kg Paddy is linked to your State Bank of India account. Current status: ${paymentStatus}.`;
        } else if (lower.includes('reach') || lower.includes('time') || lower.includes('ఎప్పుడు') || lower.includes('कब')) {
          reply = lang === 'te'
            ? `మీరు ఉదయం 10:45 గంటలకు గుంటూరు మార్కెట్ యార్డ్ గేట్ 1 వద్దకు చేరుకోవాలని సూచించడమైనది.`
            : lang === 'hi'
            ? `कृपया सुबह 10:45 बजे तक गुंटूर मुख्य मंडी गेट 1 पर पहुंचें।`
            : `You should reach Guntur Market Yard Gate 1 by 10:45 AM (15 minutes before your time slot).`;
        } else {
          reply = lang === 'te'
            ? `నేను మీ ధాన్యం స్లాట్, టోకెన్ #${activeBooking?.tokenNumber || '1059'}, నిరీక్షణ సమయం మరియు ₹19,550 DBT చెల్లింపు గురించి ప్రత్యక్ష సమాచారం ఇవ్వగలను.`
            : lang === 'hi'
            ? `मैं आपके स्लॉट, टोकन #${activeBooking?.tokenNumber || '1059'}, कतार समय और ₹19,550 डीबीटी भुगतान की लाइव जानकारी प्रदान कर सकता हूँ।`
            : `I can help you with your slot booking, token #${activeBooking?.tokenNumber || '1059'}, live waiting queue, or DBT payment status.`;
        }

        setTimeout(() => {
          setAiMessages(prev => [...prev, { id: Date.now() + 1, sender: 'ai', text: reply }]);
        }, 400);
      };

      // Render Active Component
      return h('div', { className: 'min-h-screen bg-slate-100 flex flex-col font-sans text-slate-900' },
        
        // 1. Top Government Accent Strip
        h('div', { className: 'h-1.5 w-full bg-gradient-to-r from-amber-500 via-white to-emerald-600' }),

        // 2. Aux Header
        h('div', { className: 'bg-slate-950 text-slate-200 text-xs py-1.5 px-4 sm:px-8 flex justify-between items-center' },
          h('div', { className: 'flex items-center gap-2 font-medium' },
            h('span', { className: 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse' }),
            h('span', null, 'Government of India • Ministry of Agriculture & Farmers Welfare')
          ),
          h('div', { className: 'flex items-center gap-4' },
            h('a', { href: 'tel:18001801551', className: 'text-amber-400 font-bold hover:underline' }, '📞 1800-180-1551 (24x7 Helpline)'),
            h('select', {
              value: lang,
              onChange: (e) => setLang(e.target.value),
              className: 'bg-slate-900 text-white text-xs px-2 py-0.5 rounded border border-slate-800 font-bold cursor-pointer'
            },
              h('option', { value: 'en' }, 'English'),
              h('option', { value: 'te' }, 'తెలుగు (Telugu)'),
              h('option', { value: 'hi' }, 'हिन्दी (Hindi)')
            )
          )
        ),

        // 3. Main Navigation Header
        h('header', { className: 'bg-white border-b border-slate-200 shadow-sm sticky top-0 z-40 px-4 sm:px-8 py-3 flex items-center justify-between' },
          h('div', { 
            onClick: () => setView('landing'),
            className: 'flex items-center gap-3 cursor-pointer'
          },
            h('div', { className: 'w-11 h-11 rounded-2xl bg-emerald-700 text-white flex items-center justify-center font-bold text-xl shadow' }, '🌾'),
            h('div', null,
              h('div', { className: 'font-black font-display text-slate-900 text-base tracking-tight' }, 'SMART PROCURE'),
              h('div', { className: 'text-[10px] text-slate-500 font-medium' }, 'SIH 2026 Procurement & Live Queue Platform')
            )
          ),

          // Nav Links
          h('nav', { className: 'hidden md:flex items-center gap-1 text-xs font-bold' },
            h('button', { onClick: () => setView('landing'), className: `px-3 py-2 rounded-xl transition ${view === 'landing' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-600 hover:bg-slate-50'}` }, t('home')),
            role === 'farmer' && h('button', { onClick: () => setView('dashboard'), className: `px-3 py-2 rounded-xl transition ${view === 'dashboard' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-600 hover:bg-slate-50'}` }, t('dashboard')),
            role === 'farmer' && h('button', { onClick: () => setView('book_slot'), className: `px-3 py-2 rounded-xl transition ${view === 'book_slot' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-600 hover:bg-slate-50'}` }, t('book_slot')),
            role === 'farmer' && h('button', { onClick: () => setView('queue'), className: `px-3 py-2 rounded-xl transition ${view === 'queue' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-600 hover:bg-slate-50'}` }, t('live_queue')),
            role === 'farmer' && h('button', { onClick: () => setView('procurement'), className: `px-3 py-2 rounded-xl transition ${view === 'procurement' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-600 hover:bg-slate-50'}` }, t('procurement')),
            role === 'farmer' && h('button', { onClick: () => setView('payments'), className: `px-3 py-2 rounded-xl transition ${view === 'payments' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-600 hover:bg-slate-50'}` }, t('payment')),
            role === 'farmer' && h('button', { onClick: () => setView('centres'), className: `px-3 py-2 rounded-xl transition ${view === 'centres' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-600 hover:bg-slate-50'}` }, t('centres')),
            role === 'officer' && h('button', { onClick: () => setView('officer_dashboard'), className: 'px-3 py-2 rounded-xl bg-indigo-50 text-indigo-900 font-bold' }, 'Officer Dashboard')
          ),

          // Role Switcher
          h('div', { className: 'flex items-center gap-2' },
            h('div', { className: 'flex items-center p-1 bg-slate-100 rounded-2xl border border-slate-200 text-xs font-bold' },
              h('button', {
                onClick: () => handleRoleSwitch('farmer'),
                className: `px-3 py-1.5 rounded-xl transition ${role === 'farmer' ? 'bg-emerald-700 text-white shadow' : 'text-slate-600 hover:text-slate-900'}`
              }, t('role_farmer')),
              h('button', {
                onClick: () => handleRoleSwitch('officer'),
                className: `px-3 py-1.5 rounded-xl transition ${role === 'officer' ? 'bg-indigo-900 text-white shadow' : 'text-slate-600 hover:text-slate-900'}`
              }, t('role_officer'))
            ),

            // Profile / Logout
            farmer ? h('button', {
              onClick: () => { setFarmer(null); showNotification("Farmer Logged Out"); setView('landing'); },
              className: 'px-3 py-1.5 bg-rose-50 text-rose-700 border border-rose-200 rounded-xl text-xs font-bold'
            }, 'Logout') : null
          )
        ),

        // 4. Main Body Content
        h('main', { className: 'flex-1 max-w-6xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6' },
          
          // Toast Notification
