                      },
                      className: 'w-full py-2 bg-emerald-700 text-white font-bold rounded-xl shadow hover:bg-emerald-800 mt-1'
                    }, 'Select & Confirm Token #1059 →')
                  ))
                )
              )
            )
          ),

          // VIEW 8: LIVE QUEUE PAGE
          view === 'queue' && h('div', { className: 'space-y-6' },
            h('div', { className: 'bg-white rounded-3xl p-6 border border-slate-200 shadow-sm flex justify-between items-center' },
              h('div', null,
                h('span', { className: 'text-xs text-emerald-700 font-bold uppercase' }, 'Digital APMC Board'),
                h('h2', { className: 'text-2xl font-black font-display text-slate-900' }, 'Guntur Main Agricultural Market Yard'),
                h('p', { className: 'text-xs text-slate-500' }, 'Real-time weighbridge paging & gate synchronization')
              ),
              h('button', {
                onClick: () => {
                  const nextToken = currentTokenNum + 1;
                  setCurrentTokenNum(nextToken);
                  showNotification(`Token #${nextToken} called at Weighbridge Station #3`, 'info');
                },
                className: 'px-4 py-2 bg-amber-400 text-slate-950 font-black rounded-xl text-xs shadow hover:bg-amber-300 active:scale-95'
              }, '⚡ Advance Queue (+1)')
            ),

            h('div', { className: 'grid grid-cols-1 sm:grid-cols-2 gap-4' },
              // Serving
              h('div', { className: 'p-6 rounded-3xl bg-slate-950 text-white border border-slate-800 text-center space-y-2 shadow-2xl' },
                h('span', { className: 'text-xs uppercase text-emerald-400 font-bold' }, 'Currently Serving Token'),
                h('div', { className: 'text-7xl font-black font-mono text-emerald-400' }, `#${currentTokenNum}`),
                h('div', { className: 'text-xs text-slate-400' }, 'Station: Counter 3 (Electronic Weighbridge)')
              ),

              // Farmer Token
              h('div', { className: 'p-6 rounded-3xl bg-white border border-slate-200 text-center space-y-2 shadow-xl' },
                h('span', { className: 'text-xs uppercase text-slate-400 font-bold' }, 'Your Token Position'),
                h('div', { className: 'text-6xl font-black font-mono text-slate-900' }, '#1059'),
                h('div', { className: 'text-xs font-bold text-amber-800' }, `${Math.max(0, 1059 - currentTokenNum)} farmers ahead (~${Math.max(0, (1059 - currentTokenNum) * 5)} mins wait)`)
              )
            )
          ),

          // VIEW 9: PROCUREMENT STATUS (NIR QUALITY SPECS)
          view === 'procurement' && h('div', { className: 'space-y-6' },
            h('div', { className: 'bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4' },
              h('span', { className: 'text-xs text-emerald-700 font-bold uppercase' }, 'Quality & Weight Audit'),
              h('h2', { className: 'text-2xl font-black font-display text-slate-900' }, 'Certified NIR Moisture & Quality Inspection'),
              
              h('div', { className: 'grid grid-cols-3 gap-3 text-center text-xs' },
                h('div', { className: 'p-4 bg-slate-50 rounded-2xl border border-slate-200' },
                  h('span', { className: 'text-slate-400 block' }, 'Moisture Level'),
                  h('strong', { className: 'text-xl font-mono text-emerald-800' }, '14.2%'),
                  h('span', { className: 'text-[10px] text-emerald-600 block' }, 'Pass (Max 17%)')
                ),
                h('div', { className: 'p-4 bg-slate-50 rounded-2xl border border-slate-200' },
                  h('span', { className: 'text-slate-400 block' }, 'Foreign Matter'),
                  h('strong', { className: 'text-xl font-mono text-emerald-800' }, '0.6%'),
                  h('span', { className: 'text-[10px] text-emerald-600 block' }, 'Pass (Max 1%)')
                ),
                h('div', { className: 'p-4 bg-slate-50 rounded-2xl border border-slate-200' },
                  h('span', { className: 'text-slate-400 block' }, 'Damaged Grain'),
                  h('strong', { className: 'text-xl font-mono text-emerald-800' }, '1.2%'),
                  h('span', { className: 'text-[10px] text-emerald-600 block' }, 'Pass (Max 2%)')
                )
              ),

              h('div', { className: 'p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-950 flex justify-between' },
                h('span', null, 'Certified Grade: Grade A Paddy • Net Crop Weight: 850 kg'),
                h('span', { className: 'font-bold' }, 'Assayer: Dr. K. Srinivasa Rao')
              )
            )
          ),

          // VIEW 10: DEMO DBT PAYMENT FLOW
          view === 'payments' && h('div', { className: 'max-w-xl mx-auto bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xl space-y-6' },
            h('div', { className: 'text-center space-y-1' },
              h('span', { className: 'text-xs text-emerald-700 font-bold uppercase' }, 'Direct Benefit Transfer (DBT)'),
              h('h2', { className: 'text-2xl font-black font-display text-slate-900' }, 'Government MSP Payment Payout'),
              h('p', { className: 'text-xs text-slate-500' }, 'PFMS Aadhaar Payment Bridge (APB) Settlement')
            ),

            h('div', { className: 'p-6 rounded-3xl bg-slate-950 text-white text-center space-y-2' },
              h('span', { className: 'text-xs uppercase text-emerald-300 font-bold' }, 'Total Certified MSP Amount'),
              h('div', { className: 'text-5xl font-black font-mono text-white' }, '₹19,550'),
              h('div', { className: 'text-xs text-slate-400' }, 'For 850 kg Paddy (Grade A) @ ₹2,300/Qtl + ₹20/Qtl Quality Incentive')
            ),

            h('div', { className: 'p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs space-y-2' },
              h('div', { className: 'flex justify-between' }, h('span', { className: 'text-slate-500' }, 'Beneficiary:'), h('strong', { className: 'text-slate-900' }, farmer?.name || 'Ramesh Kumar')),
              h('div', { className: 'flex justify-between' }, h('span', { className: 'text-slate-500' }, 'Bank Account:'), h('strong', { className: 'text-slate-900' }, 'State Bank of India (••••••••4108)')),
              h('div', { className: 'flex justify-between' }, h('span', { className: 'text-slate-500' }, 'Status:'), h('span', { className: `font-bold ${paymentStatus === 'Completed' ? 'text-emerald-700' : 'text-amber-700'}` }, paymentStatus === 'Completed' ? '🟢 Credited via DBT' : '🟡 Pending Settlement')),
              paymentStatus === 'Completed' && h('div', { className: 'flex justify-between border-t border-slate-200 pt-1' }, h('span', { className: 'text-slate-500' }, 'Ref UTR:'), h('strong', { className: 'font-mono text-emerald-800' }, 'DBT2026082989124'))
            ),

            h('button', {
              onClick: () => {
                setPaymentStatus('Completed');
                showNotification('₹19,550 credited via Direct Benefit Transfer! UTR: DBT2026082989124', 'success');
              },
              className: 'w-full py-3.5 bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold rounded-xl shadow text-sm'
            }, '⚡ Authorize Demo DBT Payout (Instant Credit)')
          ),

          // VIEW 11: CENTRES DIRECTORY
          view === 'centres' && h('div', { className: 'space-y-4' },
            h('h2', { className: 'text-xl font-black text-slate-900 font-display' }, 'Procurement Centres Directory'),
            h('div', { className: 'grid grid-cols-1 md:grid-cols-2 gap-3' },
              INITIAL_CENTRES.map(c => h('div', {
                key: c.centreId,
                className: 'p-4 bg-white rounded-2xl border border-slate-200 shadow-sm space-y-2 text-xs'
              },
                h('div', { className: 'flex justify-between' },
                  h('strong', { className: 'text-slate-900 text-sm' }, c.name),
                  h('span', { className: 'px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[10px]' }, '🟢 Open')
                ),
                h('div', { className: 'text-slate-500' }, c.address),
                h('div', { className: 'flex justify-between pt-2 border-t border-slate-100 text-slate-700' },
                  h('span', null, `Distance: ${c.distanceKm} km`),
                  h('span', null, `Wait: ~${c.currentWaitMinutes} mins`),
                  h('span', { className: 'font-bold text-emerald-800' }, `${c.availableSlots} slots left`)
                )
              ))
            )
          )

        ),

        // 5. Floating AI Farmer Assistant Widget
        h('div', { className: 'fixed bottom-4 right-4 z-50' },
          !aiOpen ? h('button', {
            onClick: () => setAiOpen(true),
            className: 'flex items-center gap-2 px-4 py-3 bg-gradient-to-r from-emerald-700 to-teal-800 text-white rounded-full shadow-2xl border-2 border-emerald-400/40 text-xs font-bold'
          },
            h('span', { className: 'text-base' }, '🤖'),
            h('span', null, 'AI Farmer Assistant (Voice & Chat)')
          ) : h('div', { className: 'w-80 sm:w-96 h-[480px] bg-white rounded-3xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden text-xs' },
            h('div', { className: 'p-3.5 bg-gradient-to-r from-emerald-800 to-slate-950 text-white flex justify-between items-center' },
              h('div', { className: 'flex items-center gap-2' },
                h('span', { className: 'text-lg' }, '🤖'),
                h('div', null,
                  h('div', { className: 'font-bold' }, 'AI Farmer Assistant'),
                  h('div', { className: 'text-[10px] text-emerald-200' }, 'Grounded multilingual assistance')
                )
              ),
              h('button', { onClick: () => setAiOpen(false), className: 'p-1 hover:bg-white/10 rounded' }, '✕')
            ),

            // Messages
            h('div', { className: 'flex-1 p-3 overflow-y-auto space-y-2 bg-slate-50' },
              aiMessages.map(m => h('div', {
                key: m.id,
                className: `p-2.5 rounded-2xl max-w-[85%] ${
                  m.sender === 'ai' ? 'bg-white text-slate-900 border border-slate-200 mr-auto' : 'bg-emerald-700 text-white ml-auto font-medium'
                }`
              }, m.text))
            ),

            // Suggested Chips
            h('div', { className: 'p-2 bg-slate-100 border-t border-slate-200 flex gap-1 overflow-x-auto text-[10px]' },
              h('button', { onClick: () => handleSendAiMessage("What is my token?"), className: 'px-2 py-1 bg-white border border-slate-200 rounded-full whitespace-nowrap' }, "What is my token?"),
              h('button', { onClick: () => handleSendAiMessage("How many people ahead?"), className: 'px-2 py-1 bg-white border border-slate-200 rounded-full whitespace-nowrap' }, "How many ahead?"),
              h('button', { onClick: () => handleSendAiMessage("When is my payment?"), className: 'px-2 py-1 bg-white border border-slate-200 rounded-full whitespace-nowrap' }, "Payment status?")
            ),

            // Input bar
            h('form', {
              onSubmit: (e) => { e.preventDefault(); handleSendAiMessage(); },
              className: 'p-2 bg-white border-t border-slate-200 flex gap-1'
            },
              h('button', {
                type: 'button',
                onClick: toggleVoice,
                className: `p-2 rounded-xl border text-xs ${isListening ? 'bg-rose-600 text-white animate-pulse' : 'bg-slate-100 text-slate-700'}`
              }, '🎤'),
              h('input', {
                type: 'text',
                value: aiInput,
                onChange: (e) => setAiInput(e.target.value),
                placeholder: 'Ask token, queue, payment...',
                className: 'flex-1 p-2 rounded-xl border border-slate-200 text-xs focus:outline-none'
              }),
              h('button', {
                type: 'submit',
                className: 'px-3 py-2 bg-emerald-700 text-white font-bold rounded-xl'
              }, 'Send')
            )
          )
        ),

        // 6. Footer
        h('footer', { className: 'bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500' },
          h('p', null, 'Smart Procurement Management System — Smart India Hackathon 2026'),
          h('p', { className: 'text-[11px] text-slate-400 mt-0.5' }, 'National e-Procurement Grid • Ministry of Agriculture & Farmers Welfare')
        )

      );
    }

    const rootEl = document.getElementById('root');
    if (rootEl) {
      ReactDOM.createRoot(rootEl).render(h(SmartProcureApp));
    }
  }
})();
