# ProcureFlow Environment Variables Example
# Duplicate this file to .env for local development. Never commit real credentials to source control.

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

# Client API Base URL
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------
# SMS OTP Delivery Providers
# Supported SMS_PROVIDER options:
#   1. demo   -> Generates on-screen demo OTP without making real SMS gateway requests
#   2. msg91  -> Dispatches real OTP via MSG91 gateway (requires MSG91_AUTH_KEY)
#   3. sms8   -> Dispatches real OTP via Android SIM using SMS8 gateway (requires SMS8_API_KEY)
# If SMS_PROVIDER is not set, the application preserves existing default behavior.
# ------------------------------------------------------------------
SMS_PROVIDER=demo

# MSG91 Provider Configuration (required when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# SMS8 Provider Configuration (required when SMS_PROVIDER=sms8)
# Base URL: https://app.sms8.io/services/
SMS8_API_KEY=

# Optional: Route outgoing SMS through a specific device/SIM ID configured in SMS8
# If omitted, SMS8 uses your default connected device.
SMS8_DEVICE_ID=

# Payment Gateway (Razorpay)
RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
